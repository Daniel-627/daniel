# --- Sanity (already set) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# --- Contact inbox ---
# Neon connection string (Dashboard -> Connect -> pooled connection)
DATABASE_URL=

# Admin login at /admin. Use a long passphrase (16+ characters).
ADMIN_PASSWORD=
# Random string, 32+ characters. Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=
# Random string used to hash visitor IPs for rate limiting. openssl rand -hex 16
IP_HASH_SALT=

# Telegram alerts (BotFather token, and your chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backup email via Resend
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: use your own verified domain once added in Resend
# RESEND_FROM="daniel.co.ke <hello@daniel.co.ke>"

# Optional: only if your Zoho account is not on mail.zoho.com (e.g. https://mail.zoho.eu, https://mail.zoho.in)
# ZOHO_MAIL_URL=
